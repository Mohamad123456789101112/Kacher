<UserControl x:Class="Kacher.Pos.Views.HardwareSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HardwareSettingsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Kacher.Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Configuration form -->
        <Border Grid.Column="0" Style="{StaticResource Kacher.Panel}" Padding="20" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Receipt printer -->
                    <TextBlock Text="Receipt printer" Style="{StaticResource Kacher.Title}" />
                    <TextBlock Text="Raw ESC/POS. No driver rendering, no spooler delay."
                               Style="{StaticResource Kacher.Caption}" Margin="0,2,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ProfileName}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONNECTION TYPE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding ConnectionTypes}"
                                      SelectedItem="{Binding ConnectionType}" />
                        </StackPanel>
                    </Grid>

                    <!-- Windows queue (used when ConnectionType = WindowsDriver) -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="WINDOWS PRINT QUEUE" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                  ItemsSource="{Binding PrinterQueues}"
                                  Text="{Binding ThermalPrinterName}"
                                  IsEditable="True" />
                    </StackPanel>

                    <!-- Network -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NETWORK HOST / IP" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding NetworkHost}"
                                     ToolTip="e.g. 192.168.1.50" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding NetworkPortText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Serial / USB -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERIAL PORT" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding SerialPorts}"
                                      Text="{Binding SerialPortName}"
                                      IsEditable="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BAUD" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding BaudRates}"
                                      Text="{Binding BaudRateText}"
                                      IsEditable="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="USB VID:PID" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding UsbVendorProductId}"
                                     ToolTip="e.g. 04B8:0E15" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PAPER WIDTH" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding PaperWidths}"
                                      SelectedItem="{Binding PaperWidth}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CODE PAGE" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding CodePages}"
                                      SelectedItem="{Binding SelectedCodePage}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="COPIES" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ReceiptCopiesText}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox Content="Auto-cut" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding AutoCut}" Margin="0,0,20,0" />
                        <CheckBox Content="Print QR" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding PrintQrCode}" Margin="0,0,20,0" />
                        <CheckBox Content="Print barcode" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding PrintReceiptBarcode}" Margin="0,0,20,0" />
                        <CheckBox Content="Print logo" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding PrintLogo}" />
                    </WrapPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Kacher.Divider}" Margin="0,20" />

                    <!-- Cash drawer -->
                    <TextBlock Text="Cash drawer" Style="{StaticResource Kacher.Title}" />
                    <TextBlock Text="ESC p m t1 t2 — pin, on-time and off-time in 2 ms units."
                               Style="{StaticResource Kacher.Caption}" Margin="0,2,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="OPEN DRAWER COMMAND" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding OpenDrawerCommand}"
                                     FontFamily="Consolas" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DRAWER WIRING" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding DrawerTypes}"
                                      SelectedItem="{Binding DrawerConnectionType}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="DrawerHelp" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Kacher.Caption}">
                            <Run Text="Encoded bytes:" />
                            <Run Text="{Binding DrawerPulseBytes}" FontFamily="Consolas" />
                        </TextBlock>
                    </ItemsControl>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Use pin 2 default" Style="{StaticResource Kacher.TouchButton}"
                                Height="42" MinHeight="42" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding UseDefaultDrawerPulseCommand}" />
                        <Button Content="Use pin 5" Style="{StaticResource Kacher.TouchButton}"
                                Height="42" MinHeight="42" Padding="14,0" Margin="0,0,20,0"
                                Command="{Binding UsePin5PulseCommand}" />
                        <CheckBox Content="Open on sale" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding OpenDrawerOnSale}" Margin="0,0,20,0" />
                        <CheckBox Content="Only on cash" Style="{StaticResource Kacher.CheckBox}"
                                  IsChecked="{Binding OpenDrawerOnCashPayment}" />
                    </WrapPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Kacher.Divider}" Margin="0,20" />

                    <!-- Scanner -->
                    <TextBlock Text="Barcode scanner" Style="{StaticResource Kacher.Title}" />
                    <TextBlock Text="Leave the port empty to use keyboard emulation (HID wedge)."
                               Style="{StaticResource Kacher.Caption}" Margin="0,2,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="COM PORT (OPTIONAL)" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                      ItemsSource="{Binding SerialPorts}"
                                      Text="{Binding ScannerPort}"
                                      IsEditable="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BAUD" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ScannerBaudRateText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="MIN LENGTH" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ScannerMinLengthText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="INTER-KEY (MS)" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ScannerTimeoutText}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource Kacher.Divider}" Margin="0,20" />

                    <!-- Store identity -->
                    <TextBlock Text="Receipt header" Style="{StaticResource Kacher.Title}" />
                    <TextBlock Text="Printed verbatim at the top of every receipt and Z-report."
                               Style="{StaticResource Kacher.Caption}" Margin="0,2,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STORE NAME" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding StoreName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding StorePhone}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding StoreAddress}" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TAX REGISTRATION" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding TaxRegistrationNumber}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DIGITAL RECEIPT BASE URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding DigitalReceiptBaseUrl}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,20">
                        <TextBlock Text="FOOTER MESSAGE" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding ReceiptFooter}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Test bench -->
        <Border Grid.Column="1" Style="{StaticResource Kacher.Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Test bench" Style="{StaticResource Kacher.Title}" FontSize="17" />
                <TextBlock Text="Verify the physical device before opening the shop."
                           Style="{StaticResource Kacher.Caption}" Margin="0,2,0,16" />

                <Button Content="Test print" Style="{StaticResource Kacher.PrimaryButton}"
                        Height="54" Command="{Binding TestPrintCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" Margin="0,0,0,10" />

                <Button Content="Test drawer pulse" Style="{StaticResource Kacher.AmberButton}"
                        Height="54" Command="{Binding TestDrawerCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" Margin="0,0,0,10" />

                <Button Content="Probe connection" Style="{StaticResource Kacher.TouchButton}"
                        Height="54" Command="{Binding ProbePrinterCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" Margin="0,0,0,10" />

                <Button Content="Rescan devices" Style="{StaticResource Kacher.TouchButton}"
                        Height="46" MinHeight="46" Command="{Binding RefreshDevicesCommand}" />

                <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="12"
                        Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="LAST RESULT" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding TestResult}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Kacher.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTestPassed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Kacher.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Content="Save configuration" Style="{StaticResource Kacher.PrimaryButton}"
                        Height="56" Margin="0,16,0,0" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanManage}" />

                <TextBlock Style="{StaticResource Kacher.Caption}" Margin="0,16,0,0"
                           Text="Layout preview: 80 mm prints 48 columns at Font A; 58 mm prints 32. Changing the width reflows the item table, totals and QR size automatically." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
