<Window x:Class="Kacher.Pos.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Kacher.Pos.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Kacher POS — Sign in"
        Icon="pack://application:,,,/Assets/kacher.ico"
        Width="980" Height="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border CornerRadius="24" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Branding panel -->
            <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0B4F4A" Offset="0" />
                        <GradientStop Color="#FF0F766E" Offset="0.55" />
                        <GradientStop Color="#FF0B1416" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel VerticalAlignment="Center" Margin="48,0">
                    <Border Width="96" Height="96" CornerRadius="24" Background="#22FFFFFF" HorizontalAlignment="Left">
                        <TextBlock Text="K" FontSize="56" FontWeight="Bold"
                                   Foreground="#FFFBBF24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Kacher POS" FontSize="40" FontWeight="Bold"
                               Foreground="White" Margin="0,28,0,0" />
                    <TextBlock Text="Point of sale for fast, quiet counters."
                               FontSize="16" Foreground="#CCE6F4F1" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,32,0,24" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Kacher.Success}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Local-first SQLite · works offline" Foreground="#DFF2F7F6" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Kacher.Amber}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="ESC/POS direct printing · 80 mm &amp; 58 mm" Foreground="#DFF2F7F6" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Kacher.Info}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Touch-first, keyboard-friendly" Foreground="#DFF2F7F6" FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <Button Click="OnCloseClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="12" Width="40" Height="40"
                        Style="{StaticResource Kacher.IconButton}"
                        ToolTip="Exit">
                    <Path Data="{StaticResource Icon.Close}" Stroke="White" StrokeThickness="1.7" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Sign-in panel -->
            <Border Grid.Column="1" Background="{DynamicResource Kacher.Surface}" Padding="36">
                <views:LoginView />
            </Border>
        </Grid>
    </Border>
</Window>
