<UserControl x:Class="Kacher.Pos.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InventoryViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Kacher.Panel}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource Kacher.TextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Search products" />

                    <CheckBox Grid.Column="1" Content="Low stock only"
                              Style="{StaticResource Kacher.CheckBox}"
                              IsChecked="{Binding LowStockOnly}"
                              Margin="14,0,0,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock Text="Stock value" Style="{StaticResource Kacher.Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StockValue, StringFormat={}{0:0.00} EGP}"
                                   FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        <Border Background="#33F59E0B" CornerRadius="999" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Kacher.Warning}">
                                <Run Text="{Binding LowStockCount}" />
                                <Run Text=" to reorder" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Refresh" Style="{StaticResource Kacher.TouchButton}"
                            Height="46" MinHeight="46" Padding="16,0"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                          Style="{StaticResource Kacher.DataGrid}"
                          SelectedItem="{Binding SelectedItem}"
                          RowHeight="56">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="130" />
                        <DataGridTextColumn Header="ON HAND" Binding="{Binding StockQuantity, StringFormat={}{0:0.##}}"
                                            Width="100" />
                        <DataGridTextColumn Header="REORDER AT" Binding="{Binding ReorderLevel, StringFormat={}{0:0.#}}"
                                            Width="110" />
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3322C55E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#33F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Healthy" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Kacher.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Text" Value="Low" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Kacher.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Detail: actions + movement ledger -->
        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Kacher.Panel}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=Select a product}"
                               Style="{StaticResource Kacher.Title}" />
                    <TextBlock Style="{StaticResource Kacher.Subtitle}" Margin="0,4,0,0">
                        <Run Text="On hand:" />
                        <Run Text="{Binding SelectedItem.StockQuantity, StringFormat={}{0:0.##}, TargetNullValue=—}" />
                        <Run Text=" · Reorder at:" />
                        <Run Text="{Binding SelectedItem.ReorderLevel, StringFormat={}{0:0.#}, TargetNullValue=—}" />
                    </TextBlock>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,16,0,12">
                    <Button Content="Receive stock" Style="{StaticResource Kacher.PrimaryButton}"
                            Height="50" MinHeight="50" Padding="16,0" Margin="0,0,10,10"
                            Command="{Binding ReceiveStockCommand}"
                            IsEnabled="{Binding CanAdjust}" />
                    <Button Content="Adjust" Style="{StaticResource Kacher.TouchButton}"
                            Height="50" MinHeight="50" Padding="16,0" Margin="0,0,10,10"
                            Command="{Binding AdjustStockCommand}"
                            IsEnabled="{Binding CanAdjust}" />
                    <Button Content="Write off" Style="{StaticResource Kacher.DangerButton}"
                            Height="50" MinHeight="50" Padding="16,0" Margin="0,0,0,10"
                            Command="{Binding WriteOffCommand}"
                            IsEnabled="{Binding CanAdjust}" />
                </WrapPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Movement ledger" Style="{StaticResource Kacher.Label}" Margin="0,4,0,8" />

                    <TextBlock Text="Select a product to see its history."
                               Style="{StaticResource Kacher.Caption}"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Movements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="10"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Reason}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                                           Style="{StaticResource Kacher.Caption}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Kacher.Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Delta, StringFormat={}{0:+0.##;-0.##;0}}"
                                                           FontSize="15" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Kacher.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIncrease}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Kacher.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding QuantityAfter, StringFormat=→ {0:0.##}}"
                                                           Style="{StaticResource Kacher.Caption}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
