<UserControl x:Class="Kacher.Pos.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalesViewModel}"
             d:DesignWidth="1300" d:DesignHeight="820">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Cart -->
            <ColumnDefinition Width="1.05*" MinWidth="380" />
            <!-- Catalogue -->
            <ColumnDefinition Width="1.45*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             LEFT — Cart
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Kacher.Panel}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,12,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Current sale" Style="{StaticResource Kacher.Title}" />
                        <Border Background="{DynamicResource Kacher.AccentSoft}" CornerRadius="999"
                                Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{DynamicResource Kacher.Accent}"
                                       Text="{Binding ItemCount, StringFormat={}{0} items}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Kacher.IconButton}" Width="40" Height="40"
                                Command="{Binding ApplyInvoiceDiscountCommand}" ToolTip="Order discount">
                            <TextBlock Text="%" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource Kacher.IconButton}" Width="40" Height="40"
                                Command="{Binding ClearCartCommand}" ToolTip="Clear cart">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Cart.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Kacher.TextMuted}" Opacity="0.5" />
                        <TextBlock Text="{Binding CartEmptyHint}" Style="{StaticResource Kacher.Subtitle}"
                                   TextAlignment="Center" Margin="0,14,0,0" MaxWidth="280" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Cart lines. RowHeight 72 keeps the steppers finger-sized. -->
                <DataGrid Grid.Row="1"
                          x:Name="CartGrid"
                          ItemsSource="{Binding Cart}"
                          Style="{StaticResource Kacher.DataGrid}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          RowHeight="72"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Cart.Count, Converter={StaticResource CountToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ITEM" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" Opacity="0.9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="34" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding UnitPriceDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource Kacher.TextMuted}" />
                                                <TextBlock Text=" · each" FontSize="11"
                                                           Foreground="{DynamicResource Kacher.TextMuted}" />
                                                <TextBlock Text="{Binding DiscountDisplay}" FontSize="11"
                                                           Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Kacher.Warning}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="QTY" Width="152">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="36" Height="36" Content="−"
                                                Style="{StaticResource Kacher.TouchButton}"
                                                MinHeight="36" Padding="0" FontSize="18"
                                                Command="{Binding DataContext.DecreaseQuantityCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding QuantityDisplay}"
                                                Style="{StaticResource Kacher.TouchButton}"
                                                MinHeight="36" Height="36" Width="52" Padding="0"
                                                FontSize="14" Margin="4,0"
                                                Command="{Binding DataContext.SetQuantityCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Tap to type a quantity" />
                                        <Button Width="36" Height="36" Content="+"
                                                Style="{StaticResource Kacher.TouchButton}"
                                                MinHeight="36" Padding="0" FontSize="18"
                                                Command="{Binding DataContext.IncreaseQuantityCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TOTAL" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LineTotalDisplay}" Style="{StaticResource Kacher.Money}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Kacher.IconButton}" Width="34" Height="34"
                                            Command="{Binding DataContext.RemoveLineCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove line">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource Kacher.Danger}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             RIGHT — Catalogue
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Kacher.Panel}" Margin="8,0,0,0">
            <Grid Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Persistent scan/search field -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="14"
                            BorderBrush="{DynamicResource Kacher.Accent}" BorderThickness="2" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE8B6;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" VerticalAlignment="Center" Margin="12,0,4,0"
                                       Foreground="{DynamicResource Kacher.Accent}" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="ScanBox"
                                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Kacher.TextBox}"
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="17"
                                         Tag="BarcodeInput"
                                         IsUndoEnabled="False"
                                         InputMethod.IsInputMethodEnabled="False"
                                         ToolTip="Scan a barcode here, or type a product name and press Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitBarcodeCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock Text="Scan barcode or search products…"
                                           IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontSize="15" Foreground="{DynamicResource Kacher.TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BarcodeInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Width="52" Height="52" Margin="8,0,0,0"
                            Style="{StaticResource Kacher.IconButton}"
                            Background="{DynamicResource Kacher.SurfaceRaised}"
                            Command="{Binding RefreshCatalogueCommand}"
                            ToolTip="Reload catalogue">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </Grid>

                <!-- Scan feedback -->
                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="10" Padding="12,8"
                        Visibility="{Binding ScanMessage, Converter={StaticResource NullToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#3322C55E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanSuccess}" Value="False">
                                    <Setter Property="Background" Value="#33EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Kacher.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanSuccess}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Kacher.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ScanMessage}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Category chips -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Style="{StaticResource Kacher.CategoryList}"
                         Margin="0,12,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Kacher.TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Foreground" Value="#FF0B1416" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Product grid -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                              PanningMode="VerticalOnly"
                              ScrollViewer.CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Kacher.ProductTile}"
                                        Width="166" Height="128"
                                        Command="{Binding DataContext.AddProductCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanSell}"
                                        ToolTip="{Binding Barcode}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Height="56" CornerRadius="15,15,0,0"
                                                Background="{Binding ColorHex, Converter={StaticResource HexBrush}}">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="Bold"
                                                           Foreground="#EEFFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="#CC000000" CornerRadius="999" Padding="6,2" Margin="6"
                                                        Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="LOW" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource Kacher.Amber}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="10,6,10,6">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding PriceDisplay}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource Kacher.Accent}" />
                                                <TextBlock Text="{Binding StockDisplay}" FontSize="9"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource Kacher.TextMuted}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             BOTTOM — Summary bar
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                Background="{DynamicResource Kacher.SurfaceAlt}" CornerRadius="18"
                BorderBrush="{DynamicResource Kacher.Divider}" BorderThickness="1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,26,0">
                    <TextBlock Text="SUBTOTAL" Style="{StaticResource Kacher.Label}" />
                    <TextBlock Text="{Binding Subtotal, StringFormat={}{0:0.00} EGP}"
                               Style="{StaticResource Kacher.Money}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,26,0">
                    <TextBlock Text="TAX" Style="{StaticResource Kacher.Label}" />
                    <TextBlock Text="{Binding TaxAmount, StringFormat={}{0:0.00} EGP}"
                               Style="{StaticResource Kacher.Money}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,26,0"
                            Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DISCOUNT" Style="{StaticResource Kacher.Label}" />
                    <TextBlock Text="{Binding DiscountAmount, StringFormat=-{0:0.00} EGP}"
                               Style="{StaticResource Kacher.Money}"
                               Foreground="{DynamicResource Kacher.Warning}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,22,0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL DUE" Style="{StaticResource Kacher.Label}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:0.00} EGP}"
                               Style="{StaticResource Kacher.MoneyLarge}"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource Kacher.Accent}" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cash"
                            Style="{StaticResource Kacher.AmberButton}"
                            Width="118" Height="64" Margin="0,0,10,0" FontSize="15"
                            Command="{Binding OpenCashCheckoutCommand}"
                            IsEnabled="{Binding CanPay}" />

                    <Button Content="Card"
                            Width="106" Height="64" Margin="0,0,10,0" FontSize="15"
                            Command="{Binding OpenCardCheckoutCommand}"
                            IsEnabled="{Binding CanPay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Kacher.TouchButton}" />
                        </Button.Style>
                    </Button>

                    <Button Height="64" Width="216"
                            Command="{Binding OpenCashCheckoutCommand}"
                            IsEnabled="{Binding CanPay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Kacher.PrimaryButton}" />
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Process &amp; Print" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Payment overlay
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
              Background="#CC000000"
              Visibility="{Binding IsCheckoutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="22" Background="{DynamicResource Kacher.SurfaceAlt}"
                    BorderBrush="{DynamicResource Kacher.Divider}" BorderThickness="1" Padding="26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="Take payment" Style="{StaticResource Kacher.Display}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Kacher.IconButton}"
                                Command="{Binding CloseCheckoutCommand}" ToolTip="Back to cart">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Method switch -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cash" Height="54" Margin="0,0,6,0"
                                Command="{Binding SelectCashCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Kacher.TouchButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Kacher.Accent}" />
                                            <Setter Property="Foreground" Value="#FF062B30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="Card" Height="54" Margin="6,0,0,0"
                                Command="{Binding SelectCardCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Kacher.TouchButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Kacher.Accent}" />
                                            <Setter Property="Foreground" Value="#FF062B30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Amounts -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="AMOUNT DUE" Style="{StaticResource Kacher.Label}" />
                            <TextBlock Text="{Binding Total, StringFormat={}{0:0.00} EGP}"
                                       Style="{StaticResource Kacher.MoneyLarge}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="CHANGE DUE" Style="{StaticResource Kacher.Label}" />
                            <TextBlock Text="{Binding ChangeDisplay, StringFormat={}{0} EGP}"
                                       Style="{StaticResource Kacher.MoneyLarge}"
                                       Foreground="{DynamicResource Kacher.Success}" />
                        </StackPanel>
                    </Grid>

                    <!-- Tender + keypad -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="12"
                                    Padding="14,10" BorderBrush="{DynamicResource Kacher.Accent}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding TenderedText}" FontSize="28" FontWeight="Bold"
                                           TextAlignment="Right" FontFamily="Consolas" MinHeight="36" />
                            </Border>

                            <TextBlock Text="Quick tender" Style="{StaticResource Kacher.Label}" Margin="0,12,0,6" />

                            <ItemsControl ItemsSource="{Binding TenderSuggestions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat={}{0:0.00}}"
                                                Style="{StaticResource Kacher.TouchButton}"
                                                MinHeight="42" Height="42" Padding="14,0" Margin="0,0,8,8"
                                                FontSize="13"
                                                Command="{Binding DataContext.UseSuggestionCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Exact amount"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Height="46" MinHeight="46" Margin="0,4,0,0"
                                    Command="{Binding UseExactTenderCommand}" />
                        </StackPanel>

                        <Grid Grid.Column="1" Width="252">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="7" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="7" />
                            <Button Grid.Row="0" Grid.Column="1" Content="8" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="8" />
                            <Button Grid.Row="0" Grid.Column="2" Content="9" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="9" />

                            <Button Grid.Row="1" Grid.Column="0" Content="4" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="4" />
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="5" />
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="6" />

                            <Button Grid.Row="2" Grid.Column="0" Content="1" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="1" />
                            <Button Grid.Row="2" Grid.Column="1" Content="2" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="2" />
                            <Button Grid.Row="2" Grid.Column="2" Content="3" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="3" />

                            <Button Grid.Row="3" Grid.Column="0" Content="C" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding ClearTenderCommand}" />
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding AppendTenderKeyCommand}" CommandParameter="0" />
                            <Button Grid.Row="3" Grid.Column="2" Height="52" Margin="3"
                                    Style="{StaticResource Kacher.TouchButton}"
                                    Command="{Binding BackspaceTenderCommand}">
                                <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Actions -->
                    <Button Grid.Row="4" Height="64" Margin="0,20,0,0"
                            Command="{Binding CompletePaymentCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Kacher.PrimaryButton}" />
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Complete &amp; print" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
