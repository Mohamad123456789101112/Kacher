<Window x:Class="Kacher.Pos.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MessageDialogViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="460"
        ShowInTaskbar="False"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Border Margin="18" CornerRadius="20"
            Background="{DynamicResource Kacher.SurfaceAlt}"
            BorderBrush="{DynamicResource Kacher.Divider}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Kacher.Title}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Kacher.Subtitle}"
                       Margin="0,10,0,0" TextWrapping="Wrap" />

            <!-- Optional numeric/text input -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowInput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding InputLabel}" Style="{StaticResource Kacher.Label}" Margin="0,0,0,6" />
                <TextBox x:Name="InputBox"
                         Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Kacher.TextBox}"
                         FontSize="22" />
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{DynamicResource Kacher.Danger}"
                           FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Kacher.TouchButton}"
                        Width="130" Height="50" MinHeight="50"
                        Margin="0,0,10,0"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding ConfirmText}"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Kacher.PrimaryButton}"
                        Width="150" Height="50" MinHeight="50"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
