<Window x:Class="Kacher.Pos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
        xmlns:views="clr-namespace:Kacher.Pos.Views"
        xmlns:conv="clr-namespace:Kacher.Pos.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Kacher POS"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="700"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Kacher.Surface}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{materialDesign:MaterialDesignFont}"
        FontSize="14">

    <!-- Resizable borderless window: WindowChrome gives us OS resize grips without a caption bar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:HardwareHealthToBrushConverter x:Key="HealthToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CurrencyConverter x:Key="Currency" />

        <!-- View-model → view mapping. Explicit templates keep the shell free of navigation code. -->
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Hardware pill -->
        <Style x:Key="HealthDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Title bar (draggable)
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Kacher.SurfaceAlt}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Kacher.Accent}">
                        <TextBlock Text="K" FontWeight="Bold" FontSize="13" Foreground="#FF062B30"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Kacher POS" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                    <Border Background="#1AFFFFFF" CornerRadius="999" Padding="8,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="10"
                                   Foreground="{DynamicResource Kacher.TextMuted}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Kacher.IconButton}" Width="42" Height="42"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Toggle dark / light theme">
                        <TextBlock Text="◐" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource Kacher.IconButton}" Width="42" Height="42"
                            Command="{Binding MinimizeCommand}" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Kacher.IconButton}" Width="42" Height="42"
                            Command="{Binding ToggleMaximizeCommand}" ToolTip="Maximize / restore">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Kacher.IconButton}" Width="46" Height="42"
                            Command="{Binding CloseCommand}" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFEF4444" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Status bar: cashier, shift, hardware health, clock
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource Kacher.Surface}"
                BorderBrush="{DynamicResource Kacher.Divider}" BorderThickness="0,1,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cashier -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Kacher.AccentSoft}">
                        <TextBlock Text="{Binding CashierInitial}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CashierName}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RoleText}" FontSize="10"
                                   Foreground="{DynamicResource Kacher.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Shift -->
                <Border Grid.Column="1" Style="{StaticResource Kacher.Pill}" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Kacher.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShiftIsOpen}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Kacher.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ShiftText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Hardware pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Kacher.Pill}" Margin="4,0" ToolTip="{Binding PrinterDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource HealthDot}"
                                     Fill="{Binding PrinterHealth, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock Text="PRINTER" FontSize="10" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kacher.Pill}" Margin="4,0" ToolTip="{Binding ScannerDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource HealthDot}"
                                     Fill="{Binding ScannerHealth, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock Text="SCANNER" FontSize="10" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kacher.Pill}" Margin="4,0" ToolTip="{Binding DrawerDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource HealthDot}"
                                     Fill="{Binding DrawerHealth, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock Text="DRAWER" FontSize="10" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource Kacher.TouchButton}"
                        MinHeight="40" Height="40" Padding="14,0" Margin="0,0,12,0"
                        Command="{Binding OpenDrawerCommand}"
                        ToolTip="Send the drawer kick pulse (Shift+F1)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open drawer" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clock -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ClockText}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Right" FontFamily="Consolas" />
                    <TextBlock Text="{Binding DateText}"
                               FontSize="10" HorizontalAlignment="Right"
                               Foreground="{DynamicResource Kacher.TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Navigation + content
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource Kacher.SurfaceAlt}"
                    BorderBrush="{DynamicResource Kacher.Divider}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="216" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationExpanded}" Value="False">
                                <Setter Property="Width" Value="84" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,14">
                        <Button Command="{Binding ToggleNavigationCommand}"
                                Style="{StaticResource Kacher.IconButton}"
                                HorizontalAlignment="Center" ToolTip="Collapse / expand navigation">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <Button Command="{Binding SignOutCommand}"
                                Style="{StaticResource Kacher.TouchButton}"
                                Margin="0,8,0,0" Height="46" MinHeight="46" ToolTip="Sign out">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Sign out" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNavigationExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}"
                             Style="{StaticResource Kacher.NavList}"
                             Margin="0,14,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" CornerRadius="10"
                                            Background="{DynamicResource Kacher.AccentSoft}">
                                        <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource Kacher.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14"
                                               VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsNavigationExpanded,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content host -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,18,24,6">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Kacher.Display}" />
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Kacher.Subtitle}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="12,6,16,12"
                                Focusable="False" />
            </Grid>
        </Grid>

        <!-- Toast host -->
        <materialDesign:Snackbar x:Name="Toast" Grid.Row="2"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
</Window>
