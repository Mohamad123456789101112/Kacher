<UserControl x:Class="Kacher.Pos.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InvoicesViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="380" />
            <ColumnDefinition Width="1*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Left: search + result list
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Kacher.Panel}" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Margin="16,16,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox Style="{StaticResource Kacher.TextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="Invoice number, barcode, product or cashier"
                                 Padding="44,12,12,12" />

                        <Path Style="{StaticResource Kacher.IconMuted}" Data="{StaticResource Icon.Search}"
                              HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <Button Grid.Column="1" Style="{StaticResource Kacher.IconButton}"
                            Width="44" Height="44" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh">
                        <Path Style="{StaticResource Kacher.IconMuted}" Data="{StaticResource Icon.Refresh}" />
                    </Button>

                    <CheckBox Grid.Column="2" Style="{StaticResource Kacher.CheckBox}"
                              Content="Today only" IsChecked="{Binding TodayOnly}"
                              Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Invoices}"
                         SelectedItem="{Binding Selected}"
                         Style="{StaticResource Kacher.NavList}"
                         Margin="8,0,8,8" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="12"
                                        Background="{DynamicResource Kacher.AccentSoft}">
                                    <Path Style="{StaticResource Kacher.IconAccent}" Width="18" Height="18"
                                          Data="{StaticResource Icon.Receipt}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Kacher.TextPrimary}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Kacher.TextMuted}">
                                        <Run Text="{Binding CreatedAt, StringFormat={}{0:dd MMM · HH:mm}, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding CashierName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:0.00} EGP}"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Kacher.TextPrimary}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Kacher.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: count on the left, live printer health on the right -->
                <Grid Grid.Row="2" Margin="16,0,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Kacher.Caption}">
                            <Run Text="{Binding Invoices.Count, Mode=OneWay}" />
                            <Run Text="invoices" />
                            <Run Text=" · " />
                            <Run Text="{Binding LastInvoiceText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="10" Padding="10,6"
                            Background="{DynamicResource Kacher.SurfaceAlt}"
                            ToolTip="{Binding PrinterHint}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Kacher.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrinterReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Kacher.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Path Style="{StaticResource Kacher.IconMuted}" Width="13" Height="13"
                                  Margin="7,0,0,0" Data="{StaticResource Icon.Print}" />
                            <TextBlock Text="Printer" FontSize="11" Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Kacher.TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════
             Right: detail + actions
             ═══════════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Kacher.Panel}">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280"
                            Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}">
                    <Border Style="{StaticResource Kacher.IconBadge}" Width="60" Height="60" CornerRadius="20"
                            HorizontalAlignment="Center">
                        <Path Style="{StaticResource Kacher.IconAccent}" Width="26" Height="26"
                              Data="{StaticResource Icon.Receipt}" />
                    </Border>
                    <TextBlock Text="Select an invoice" Style="{StaticResource Kacher.Title}" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Choose a sale on the left to see its lines, reprint the receipt or issue a refund."
                               Style="{StaticResource Kacher.Caption}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Detail, Converter={StaticResource NullToVisibility},
                                           ConverterParameter=invert}">
                    <StackPanel Margin="18">

                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Detail.InvoiceNumber}" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Kacher.TextPrimary}" />
                                <TextBlock Style="{StaticResource Kacher.Caption}" Margin="0,2,0,0">
                                    <Run Text="{Binding Detail.CreatedAtLocal, StringFormat={}{0:dd MMMM yyyy · HH:mm}, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Detail.CashierName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource Kacher.Pill}">
                                <TextBlock Text="{Binding Detail.PaymentText}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- Refunded banner -->
                        <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,12"
                                Background="{DynamicResource Kacher.Danger}" Opacity="0.16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail.IsRefunded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="This invoice has been refunded." FontSize="12"
                                       Foreground="{DynamicResource Kacher.Danger}" FontWeight="SemiBold" />
                        </Border>

                        <!-- Lines -->
                        <ItemsControl ItemsSource="{Binding Detail.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{DynamicResource Kacher.TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Kacher.Caption}" FontSize="10.5">
                                                <Run Text="{Binding Quantity, StringFormat={}{0:0.##}, Mode=OneWay}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding UnitPrice, StringFormat={}{0:0.00}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:0.00}}"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Kacher.TextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8" Background="{DynamicResource Kacher.Divider}" />

                        <!-- Totals -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" Style="{StaticResource Kacher.Caption}" />
                            <TextBlock Text="{Binding Detail.SubtotalText}" HorizontalAlignment="Right"
                                       Style="{StaticResource Kacher.Caption}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Discount" Style="{StaticResource Kacher.Caption}" />
                            <TextBlock Text="{Binding Detail.DiscountText, StringFormat=-{0}}"
                                       HorizontalAlignment="Right" Style="{StaticResource Kacher.Caption}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="VAT" Style="{StaticResource Kacher.Caption}" />
                            <TextBlock Text="{Binding Detail.TaxText}" HorizontalAlignment="Right"
                                       Style="{StaticResource Kacher.Caption}" />
                        </Grid>

                        <Border CornerRadius="12" Padding="14,10" Background="{DynamicResource Kacher.AccentSoft}">
                            <Grid>
                                <TextBlock Text="TOTAL" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Kacher.Accent}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detail.TotalText}" HorizontalAlignment="Right"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource Kacher.Accent}" />
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource Kacher.TouchButton}" Height="48"
                                    MinHeight="48" Margin="0,0,6,0" Command="{Binding ReprintCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Kacher.IconMuted}" Data="{StaticResource Icon.Print}" />
                                    <TextBlock Text="Reprint" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource Kacher.TouchButton}" Height="48"
                                    MinHeight="48" Margin="6,0,0,0" Command="{Binding SavePdfCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Kacher.IconMuted}" Data="{StaticResource Icon.Download}" />
                                    <TextBlock Text="Save PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource Kacher.DangerButton}" Height="50" MinHeight="50"
                                Margin="0,10,0,0" Command="{Binding RefundCommand}"
                                IsEnabled="{Binding CanRefund}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Kacher.Icon}" Data="{StaticResource Icon.Undo}"
                                      Stroke="White" />
                                <TextBlock Text="Refund this invoice" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
