<UserControl x:Class="Kacher.Pos.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:views="clr-namespace:Kacher.Pos.Views"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="780">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <TabControl Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                SelectedIndex="{Binding SelectedTab}">

        <!-- ═══ General ═══ -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Kacher.Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource Kacher.Title}" FontSize="17" />
                                <TextBlock Text="Dark mode is the default for low-light counters; light mode suits bright shopfronts."
                                           Style="{StaticResource Kacher.Caption}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Dark mode" Style="{StaticResource Kacher.Subtitle}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                          Command="{Binding ToggleThemeCommand}"
                                          Style="{StaticResource Kacher.CheckBox}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Kacher.Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Local data" Style="{StaticResource Kacher.Title}" FontSize="17" />
                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Kacher.Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="10"
                                        Padding="12,8" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="DATABASE SIZE" Style="{StaticResource Kacher.Label}" />
                                        <TextBlock Text="{Binding DatabaseSize}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="10"
                                        Padding="12,8" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="MACHINE" Style="{StaticResource Kacher.Label}" />
                                        <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Kacher.SurfaceRaised}" CornerRadius="10"
                                        Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="RUNTIME" Style="{StaticResource Kacher.Label}" />
                                        <TextBlock Text="{Binding RuntimeInfo}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Open data folder" Style="{StaticResource Kacher.TouchButton}"
                                        Height="46" MinHeight="46" Padding="16,0" Margin="0,0,10,0"
                                        Command="{Binding OpenDataFolderCommand}" />
                                <Button Content="Compact database" Style="{StaticResource Kacher.TouchButton}"
                                        Height="46" MinHeight="46" Padding="16,0"
                                        Command="{Binding CompactDatabaseCommand}"
                                        IsEnabled="{Binding CanManageUsers}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kacher.Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Currency &amp; tax" Style="{StaticResource Kacher.Title}" FontSize="17" />
                            <TextBlock Text="Prices and tax rates are stored per product; receipts print EGP and the VAT band of each line."
                                       Style="{StaticResource Kacher.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ Operators ═══ -->
        <TabItem Header="Operators">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Kacher.Panel}" Padding="16" Margin="0,0,12,0">
                    <DataGrid ItemsSource="{Binding Users}"
                              Style="{StaticResource Kacher.DataGrid}"
                              SelectedItem="{Binding SelectedUser}"
                              RowHeight="52">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="LOGIN" Binding="{Binding UserName}" Width="120" />
                            <DataGridTextColumn Header="ROLE" Binding="{Binding RoleText}" Width="110" />
                            <DataGridTextColumn Header="LAST SIGN-IN" Binding="{Binding LastLoginText}" Width="130" />
                            <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Kacher.IconButton}" Width="34" Height="34"
                                                    ToolTip="Change PIN"
                                                    Command="{Binding DataContext.ChangePinCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource Kacher.IconButton}" Width="34" Height="34"
                                                    ToolTip="Enable / disable"
                                                    Command="{Binding DataContext.ToggleUserActiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Kacher.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Add an operator" Style="{StaticResource Kacher.Title}" FontSize="17" />
                        <TextBlock Text="PINs are salted and hashed with PBKDF2-SHA256 (210k iterations)."
                                   Style="{StaticResource Kacher.Caption}" Margin="0,2,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource Kacher.Label}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding NewUserName}" />

                        <TextBlock Text="LOGIN (OPTIONAL)" Style="{StaticResource Kacher.Label}" Margin="0,10,0,4" />
                        <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding NewLoginName}" />

                        <TextBlock Text="PIN (4-6 DIGITS)" Style="{StaticResource Kacher.Label}" Margin="0,10,0,4" />
                        <TextBox Style="{StaticResource Kacher.TextBox}" Text="{Binding NewPin}" MaxLength="6" />

                        <TextBlock Text="ROLE" Style="{StaticResource Kacher.Label}" Margin="0,10,0,4" />
                        <ComboBox Style="{StaticResource Kacher.ComboBox}"
                                  ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" />

                        <Button Content="Create operator" Style="{StaticResource Kacher.PrimaryButton}"
                                Height="52" Margin="0,18,0,0" Command="{Binding CreateUserCommand}"
                                IsEnabled="{Binding CanManageUsers}" />

                        <TextBlock Style="{StaticResource Kacher.Caption}" Margin="0,14,0,0"
                                   Text="Cashiers can sell and open the drawer. Supervisors also refund, discount, adjust stock and close shifts. Admins manage everything." />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ═══ Hardware ═══ -->
        <TabItem Header="Hardware">
            <views:HardwareSettingsView DataContext="{Binding Hardware}" Margin="0,12,0,0" />
        </TabItem>

        <!-- ═══ About ═══ -->
        <TabItem Header="About">
            <Border Style="{StaticResource Kacher.Card}" MaxWidth="720" HorizontalAlignment="Left"
                    Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Kacher.Accent}">
                            <TextBlock Text="K" FontSize="30" FontWeight="Bold" Foreground="#FF062B30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kacher POS" Style="{StaticResource Kacher.Title}" />
                            <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                                       Style="{StaticResource Kacher.Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Kacher.Divider}" Margin="0,18" />

                    <TextBlock Style="{StaticResource Kacher.Subtitle}" TextWrapping="Wrap"
                               Text="A local-first retail terminal: .NET 8 · WPF · MVVM · EF Core (SQLite) · Material Design 3 · raw ESC/POS." />

                    <TextBlock Style="{StaticResource Kacher.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="All data stays on this machine. Back up the data folder regularly; the SQLite database is crash-safe thanks to WAL journalling." />
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
