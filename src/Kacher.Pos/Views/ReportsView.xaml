<UserControl x:Class="Kacher.Pos.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kacher.Pos.ViewModels"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}"
             d:DesignWidth="1280" d:DesignHeight="800">

    <UserControl.Resources>
        <conv:RatioToHeightConverter x:Key="RatioToHeight" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Kacher.Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="158" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Kacher.IconButton}" Command="{Binding PreviousDayCommand}"
                        ToolTip="Previous day">
                    <Path Style="{StaticResource Kacher.IconMuted}" Width="14" Height="14" Data="{StaticResource Icon.Collapse}" />
                </Button>

                <Border Background="{DynamicResource Kacher.SurfaceAlt}" CornerRadius="12" Padding="12,6"
                        BorderBrush="{DynamicResource Kacher.Divider}" BorderThickness="1" Margin="4,0">
                    <DatePicker SelectedDate="{Binding SelectedDate}" BorderThickness="0"
                                Background="Transparent" FontSize="14" Width="160" />
                </Border>

                <Button Style="{StaticResource Kacher.IconButton}" Command="{Binding NextDayCommand}"
                        ToolTip="Next day">
                    <Path Style="{StaticResource Kacher.IconMuted}" Width="14" Height="14" Data="{StaticResource Icon.Expand}" />
                </Button>

                <Button Content="Today" Style="{StaticResource Kacher.TouchButton}" Height="42" MinHeight="42"
                        Padding="14,0" Margin="10,0,0,0" Command="{Binding TodayCommand}" />
                <Button Content="Yesterday" Style="{StaticResource Kacher.TouchButton}" Height="42" MinHeight="42"
                        Padding="14,0" Margin="8,0,0,0" Command="{Binding YesterdayCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export CSV" Style="{StaticResource Kacher.TouchButton}"
                        Height="42" MinHeight="42" Padding="14,0" Margin="0,0,8,0"
                        Command="{Binding ExportCsvCommand}"
                        IsEnabled="{Binding IsBusyExport, Converter={StaticResource InverseBool}}" />
                <Button Content="Export PDF" Style="{StaticResource Kacher.TouchButton}"
                        Height="42" MinHeight="42" Padding="14,0" Margin="0,0,8,0"
                        Command="{Binding ExportPdfCommand}"
                        IsEnabled="{Binding IsBusyExport, Converter={StaticResource InverseBool}}" />
                <Button Content="Open folder" Style="{StaticResource Kacher.TouchButton}"
                        Height="42" MinHeight="42" Padding="14,0"
                        Command="{Binding OpenReportsFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- KPI strip: same visual language as the dashboard (icon badge + label + value) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">

            <Border Style="{StaticResource KpiCard}" MinWidth="196">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.AccentSoft}">
                        <Path Style="{StaticResource Kacher.IconAccent}" Width="20" Height="20"
                              Data="{StaticResource Icon.Trend}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GROSS SALES" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding GrossSales, StringFormat={}{0:0.00} EGP}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.TextPrimary}" />
                        <TextBlock Text="{Binding InvoiceCount, StringFormat={}{0} invoices}"
                                   Style="{StaticResource Kacher.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource KpiCard}" MinWidth="176">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.SurfaceHigh}">
                        <Path Style="{StaticResource Kacher.IconMuted}" Width="20" Height="20"
                              Data="{StaticResource Icon.Reports}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NET (EX-VAT)" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding NetSales, StringFormat={}{0:0.00}}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.TextPrimary}" />
                        <TextBlock Text="before tax" Style="{StaticResource Kacher.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource KpiCard}" MinWidth="176">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.SurfaceHigh}">
                        <Path Style="{StaticResource Kacher.IconMuted}" Width="20" Height="20"
                              Data="{StaticResource Icon.Tag}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VAT COLLECTED" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding TaxTotal, StringFormat={}{0:0.00}}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.TextPrimary}" />
                        <TextBlock Text="payable to the tax office" Style="{StaticResource Kacher.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource KpiCard}" MinWidth="176">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.SurfaceHigh}">
                        <Path Style="{StaticResource Kacher.IconMuted}" Width="20" Height="20"
                              Data="{StaticResource Icon.Cart}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AVERAGE BASKET" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding AverageBasket, StringFormat={}{0:0.00}}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.TextPrimary}" />
                        <TextBlock Text="per invoice" Style="{StaticResource Kacher.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource KpiCard}" MinWidth="196">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.SurfaceHigh}">
                        <Path Style="{StaticResource Kacher.IconMuted}" Width="20" Height="20"
                              Data="{StaticResource Icon.Cash}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CASH / CARD" Style="{StaticResource Kacher.Label}" />
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Kacher.TextPrimary}">
                            <Run Text="{Binding CashTotal, StringFormat={}{0:0.00}, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding CardTotal, StringFormat={}{0:0.00}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Kacher.Caption}">
                            <Run Text="Refunds " />
                            <Run Text="{Binding RefundTotal, StringFormat={}{0:0.00}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource KpiCard}" MinWidth="176" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Kacher.IconBadge}" Background="{DynamicResource Kacher.WarningSoft}">
                        <Path Style="{StaticResource Kacher.Icon}" Width="20" Height="20"
                              Stroke="{DynamicResource Kacher.Warning}" Data="{StaticResource Icon.Tag}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DISCOUNTS" Style="{StaticResource Kacher.Label}" />
                        <TextBlock Text="{Binding DiscountTotal, StringFormat={}{0:0.00}}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Kacher.Warning}" />
                        <TextBlock Text="given today" Style="{StaticResource Kacher.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>
        </WrapPanel>

        <!-- Charts + lists -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hourly bars -->
                <Border Grid.Row="0" Style="{StaticResource Kacher.Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Revenue by hour" Style="{StaticResource Kacher.Title}" FontSize="16" />
                        <TextBlock Text="Hover a bar for the exact figure"
                                   Style="{StaticResource Kacher.Caption}" Margin="0,2,0,12" />

                        <ItemsControl ItemsSource="{Binding Hourly}" Height="150">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="3,0"
                                                ToolTip="{Binding Tooltip}">
                                        <Border Height="{Binding Ratio, Converter={StaticResource RatioToHeight}, ConverterParameter=110}"
                                                CornerRadius="6,6,0,0"
                                                Background="{DynamicResource Kacher.Accent}" />
                                        <TextBlock Text="{Binding Label}" FontSize="9" TextAlignment="Center"
                                                   Foreground="{DynamicResource Kacher.TextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Invoice history -->
                <Border Grid.Row="1" Style="{StaticResource Kacher.Card}" Margin="0,0,12,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Invoices" Style="{StaticResource Kacher.Title}" FontSize="16"
                                   Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}"
                                  Style="{StaticResource Kacher.DataGrid}"
                                  SelectedItem="{Binding SelectedInvoice}"
                                  RowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE" Binding="{Binding InvoiceNumber}" Width="160" />
                                <DataGridTextColumn Header="TIME"
                                                    Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm}}"
                                                    Width="70" />
                                <DataGridTextColumn Header="CASHIER" Binding="{Binding CashierName}" Width="*" />
                                <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" Width="90" />
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="70" />
                                <DataGridTextColumn Header="TOTAL"
                                                    Binding="{Binding TotalAmount, StringFormat={}{0:0.00}}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top products -->
                <Border Grid.Row="0" Style="{StaticResource Kacher.Card}">
                    <StackPanel>
                        <TextBlock Text="Top sellers" Style="{StaticResource Kacher.Title}" FontSize="16" />
                        <TextBlock Text="By revenue, tax inclusive"
                                   Style="{StaticResource Kacher.Caption}" Margin="0,2,0,12" />

                        <TextBlock Text="No sales recorded for this day."
                                   Style="{StaticResource Kacher.Caption}"
                                   Visibility="{Binding TopProducts.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />

                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##} sold}"
                                                       Style="{StaticResource Kacher.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Revenue, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource Kacher.Money}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tax bands -->
                <Border Grid.Row="1" Style="{StaticResource Kacher.Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Tax breakdown" Style="{StaticResource Kacher.Title}" FontSize="16"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding TaxBands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" FontSize="13" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:0.00}}"
                                                       Style="{StaticResource Kacher.Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Kacher.Caption}" />
                                            <TextBlock Text="{Binding TaxAmount, StringFormat={}{0:0.00}}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
