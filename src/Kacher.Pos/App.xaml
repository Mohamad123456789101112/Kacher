<Application x:Class="Kacher.Pos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Kacher.Pos.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- BundledTheme ships both Material Design palettes; BaseTheme is switched at
                     runtime by ThemeService (PaletteHelper + ThemeManager). -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Amber" />

                <!-- Material Design 3 defaults: ripple, elevation, touch-friendly control templates.
                     Swapping this for MaterialDesign2.Defaults.xaml is a one-line change. -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- App palette + component styles -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <!-- Vector icon set (24 × 24 grid, stroke style). No icon font, no DPI surprises. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters: available to every view and dialog without local resources -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:CurrencyConverter x:Key="Currency" />
            <conv:HexToBrushConverter x:Key="HexBrush" />
            <conv:HexToColorConverter x:Key="HexColor" />
            <conv:ImagePathToSourceConverter x:Key="ImageSource" />
            <conv:ResourceIconConverter x:Key="IconKey" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
