<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════════════════════
         Brand + semantic palette. Values are chosen for a bright retail environment:
         high contrast, saturated accents, and no thin grey text on grey backgrounds.
         ThemeService overrides the surface brushes when Light mode is selected.
         ═══════════════════════════════════════════════════════════════════════════════════════ -->

    <Color x:Key="KacherTeal">#FF0F766E</Color>
    <Color x:Key="KacherTealDark">#FF0B4F4A</Color>
    <Color x:Key="KacherAmber">#FFFBBF24</Color>
    <Color x:Key="KacherInk">#FF0B1416</Color>

    <!-- Surfaces (dark defaults) -->
    <SolidColorBrush x:Key="Kacher.Surface" Color="#FF101A1C" />
    <SolidColorBrush x:Key="Kacher.SurfaceAlt" Color="#FF162326" />
    <SolidColorBrush x:Key="Kacher.SurfaceRaised" Color="#FF1D2D31" />
    <SolidColorBrush x:Key="Kacher.Divider" Color="#FF2A3C40" />
    <SolidColorBrush x:Key="Kacher.TextPrimary" Color="#FFF1F5F6" />
    <SolidColorBrush x:Key="Kacher.TextSecondary" Color="#FFB4C4C7" />
    <SolidColorBrush x:Key="Kacher.TextMuted" Color="#FF7E9295" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Kacher.Accent" Color="#FF14B8A6" />
    <SolidColorBrush x:Key="Kacher.AccentSoft" Color="#3314B8A6" />
    <SolidColorBrush x:Key="Kacher.Amber" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Kacher.Success" Color="#FF22C55E" />
    <SolidColorBrush x:Key="Kacher.Warning" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="Kacher.Danger" Color="#FFEF4444" />
    <SolidColorBrush x:Key="Kacher.Info" Color="#FF38BDF8" />

    <!-- Money highlight (receipt total / change due) -->
    <LinearGradientBrush x:Key="Kacher.TotalGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0F766E" Offset="0" />
        <GradientStop Color="#FF0B4F4A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Kacher.PayGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF14B8A6" Offset="0" />
        <GradientStop Color="#FF0D9488" Offset="1" />
    </LinearGradientBrush>

    <!-- Cash drawer / hardware pills -->
    <SolidColorBrush x:Key="Kacher.HardwareOnline" Color="#FF22C55E" />
    <SolidColorBrush x:Key="Kacher.HardwareDegraded" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="Kacher.HardwareOffline" Color="#FFEF4444" />
    <SolidColorBrush x:Key="Kacher.HardwareUnknown" Color="#FF64748B" />

    <!-- Shadows used by the elevated cards -->
    <DropShadowEffect x:Key="Kacher.CardShadow"
                      BlurRadius="18" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.45" />
</ResourceDictionary>
